# Environment configuration for Pixer
# Set to "true" to disable Vite HMR file watching in sandboxed environments
DISABLE_HMR=false

# Optional Phase 2 Cloud Offload (Cloudflare Workers + R2 CDN + Supabase Option A)
# Leave blank for 100% local offline-first mode.
VITE_CLOUD_API_BASE=
VITE_CDN_BASE_URL=
