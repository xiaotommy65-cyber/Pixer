{
  "name": "pixel-atelier",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "sim": "node --expose-gc --experimental-strip-types scripts/headless-sim.ts",
    "test": "node --experimental-strip-types --test scripts/sim/EcsCore.test.ts scripts/sim/WorldMap.test.ts scripts/sim/Engine10Core.test.ts scripts/sim/Interop.test.ts scripts/sim/DualPerspective3D.test.ts scripts/sim/Spatial3DMesh.test.ts scripts/sim/WorldMap3D.test.ts scripts/sim/Model3DInterop.test.ts scripts/sim/Hd2dFeel.test.ts scripts/sim/CloudOffload.test.ts scripts/sim/Workstation2.test.ts",
    "mcp": "node --experimental-strip-types scripts/pixer-mcp.ts",
    "audit": "node --experimental-strip-types scripts/pixer-audit.ts",
    "audit:status": "node --experimental-strip-types scripts/pixer-audit.ts --only=status",
    "audit:math": "node --experimental-strip-types scripts/pixer-audit.ts --only=math",
    "audit:perf": "node --experimental-strip-types scripts/pixer-audit.ts --only=perf",
    "audit:json": "node --experimental-strip-types scripts/pixer-audit.ts --json",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@webgpu/types": "^0.1.74",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "fflate": "^0.8.3",
    "maxrects-packer": "^3.0.0"
  }
}
