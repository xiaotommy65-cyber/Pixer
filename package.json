{
  "name": "pixel-atelier",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=::",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port=3000 --host=::",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "sim": "node --experimental-strip-types scripts/headless-sim.ts",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@webgpu/types": "^0.1.74",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  }
}
